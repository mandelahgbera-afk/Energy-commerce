{
  "$schema": "https://opencode.ai/config.json",
  "compaction": { "auto": true, "prune": false },
  "watcher": { "ignore": ["node_modules/**", "sim/node_modules/**", ".next/**", "sim/reports/**", "design/lottie/**"] },
  "permission": {
    "doom_loop": "deny",
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "task": { "*": "deny", "explore": "allow", "reviewer": "allow" },
    "skill": { "*": "deny", "power-*": "allow" },
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow" },
    "edit": {
      "*": "allow",
      "AGENTS.md": "ask",
      ".opencode/*": "ask",
      "opencode.json": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "supabase/migrations/20261101*": "deny",
      "supabase\\migrations\\20261101*": "deny",
      "sim/check.mjs": "deny",
      "sim\\check.mjs": "deny",
      "sim/make-baseline.mjs": "deny",
      "sim\\make-baseline.mjs": "deny",
      "sim/baseline.json": "deny",
      "sim\\baseline.json": "deny",
      "sim/stubs.sql": "deny",
      "sim\\stubs.sql": "deny"
    },
    "bash": {
      "*": "ask",
      "cd *": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "node edge.mjs*": "allow",
      "node race.mjs*": "allow",
      "node simulate.mjs*": "allow",
      "node check.mjs*": "allow",
      "node sim/*": "allow",
      "node design/checks/*": "allow",
      "node ~/.claude/tools/dev-clean.mjs*": "allow",
      "npm run *": "allow",
      "npm test*": "allow",
      "npm ci*": "allow",
      "npx tsc*": "allow",
      "npx eslint*": "allow",
      "npx next *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git init*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git branch*": "allow",
      "git switch *": "allow",
      "npm install*": "ask",
      "npm i *": "ask",
      "npm uninstall*": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "node make-baseline.mjs*": "deny",
      "node sim/make-baseline.mjs*": "deny",
      "git push*": "deny",
      "git remote*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git restore*": "deny",
      "git checkout -- *": "deny",
      "git stash drop*": "deny",
      "git commit --no-verify*": "deny",
      "git commit --amend*": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -r *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "rd *": "deny",
      "Remove-Item*": "deny",
      "docker system prune*": "deny",
      "docker image prune*": "deny",
      "docker volume prune*": "deny",
      "supabase db push*": "deny",
      "supabase db reset*": "deny",
      "supabase link*": "deny",
      "supabase login*": "deny",
      "npx supabase db push*": "deny",
      "npx supabase link*": "deny",
      "npx supabase login*": "deny",
      "vercel*": "deny",
      "npx vercel*": "deny",
      "npm publish*": "deny",
      "ffmpeg*": "deny"
    }
  }
}
